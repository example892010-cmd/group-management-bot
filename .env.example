# Telegram bot credentials (never share BOT_TOKEN)
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN

# Telegram numeric user ID(s) allowed to use global owner commands
OWNER_ID=123456789

# Numeric ID of the single group allowed to use anime availability and custom conversation auto-replies.
# Leave blank to disable those owner-group-only auto-reply features.
OWNER_GROUP_ID=

# SQLite database. On Render, use /var/data/... only when a persistent disk is attached.
DATABASE_PATH=./data/aniflix_group_management.db

# Data and logs folders (keep on the same persistent mount if using one)
DATA_DIR=.
LOG_FILE=./logs/aniflix.log
LOG_LEVEL=INFO

# Channel included in Tamil anime availability responses
BOT_CHANNEL_USERNAME=@ANIFLIXANIMETAMIL

# Render supplies PORT automatically; local default is 10000
PORT=10000
